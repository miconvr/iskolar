{
  "manifest_version": 3,
  "name": "Iskolar",
  "version": "1.0.0",
  "description": "See what the website you are on offers students. Matches locally. No tracking, no data collected.",
  "permissions": ["activeTab"],
  "host_permissions": ["https://raw.githubusercontent.com/miconvr/iskolar/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Iskolar",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}